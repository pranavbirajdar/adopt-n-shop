# Adopt n Shop - Environment Variables Template
# Copy this file to .env and configure for local development or deployment

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key (Set a random, secure string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database URL (Defaults to local SQLite if omitted)
# Example for SQLite: sqlite:///adoptnshop.db
# Example for PostgreSQL: postgresql://user:password@localhost:5432/adoptnshop
DATABASE_URL=sqlite:///adoptnshop.db
